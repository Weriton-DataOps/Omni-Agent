{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "strict": true, "esModuleInterop": true,
    "skipLibCheck": true, "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "allowJs": true, "checkJs": false, "noEmit": true,
    "types": ["node", "vite/client"]
  },
  "include": ["src", "electron.vite.config.ts"]
}
