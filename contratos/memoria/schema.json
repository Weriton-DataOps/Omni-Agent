{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Weriton-DataOps/Omni-Agent/contratos/memoria/schema.json",
  "title": "Omni Memory V4",
  "type": "object",
  "required": ["schemaVersion", "store", "confirmed", "candidates", "archive"],
  "properties": {
    "schemaVersion": { "const": 4 },
    "store": {
      "type": "object",
      "required": ["id", "createdAt", "updatedAt", "lastMigrationAt", "lastMaintenanceAt"],
      "properties": {
        "id": { "const": "omni-local-memory" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "lastMigrationAt": { "type": ["string", "null"], "format": "date-time" },
        "lastMaintenanceAt": { "type": ["string", "null"], "format": "date-time" }
      },
      "additionalProperties": false
    },
    "confirmed": {
      "type": "array",
      "items": { "$ref": "#/$defs/confirmedMemory" }
    },
    "candidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/candidateMemory" }
    },
    "archive": {
      "type": "array",
      "items": { "$ref": "#/$defs/archivedMemory" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "scope": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["user", "project", "task", "environment"] },
        "id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["kind", "recordedAt"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "recordedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "baseMemory": {
      "type": "object",
      "required": [
        "id", "type", "scope", "projectId", "text", "source", "status", "confidence",
        "importance", "occurrences", "validation", "evidence", "createdAt", "updatedAt",
        "lastValidatedAt", "usageCount", "expiresAt"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^mem-" },
        "type": { "enum": ["preference", "episodic", "semantic", "procedural", "objective", "capability"] },
        "scope": { "$ref": "#/$defs/scope" },
        "projectId": { "type": ["string", "null"], "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "status": { "enum": ["confirmed", "candidate"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "importance": { "type": "number", "minimum": 0, "maximum": 1 },
        "occurrences": { "type": "integer", "minimum": 1 },
        "validation": {
          "type": "object",
          "required": ["status", "reasons"],
          "properties": {
            "status": { "enum": ["pending", "validated", "confirmed"] },
            "reasons": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" }, "minItems": 1 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "lastValidatedAt": { "type": ["string", "null"], "format": "date-time" },
        "usageCount": { "type": "integer", "minimum": 0 },
        "expiresAt": { "type": ["string", "null"], "format": "date-time" }
      },
      "additionalProperties": false
    },
    "confirmedMemory": {
      "allOf": [
        { "$ref": "#/$defs/baseMemory" },
        { "properties": { "status": { "const": "confirmed" } } }
      ]
    },
    "candidateMemory": {
      "allOf": [
        { "$ref": "#/$defs/baseMemory" },
        { "properties": { "status": { "const": "candidate" } } }
      ]
    },
    "archivedMemory": {
      "type": "object",
      "required": [
        "id", "memoryId", "action", "reason", "archivedAt", "replacementId", "snapshot"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^arc-" },
        "memoryId": { "type": "string", "pattern": "^mem-" },
        "action": {
          "enum": ["expired", "stale-candidate", "capacity", "discarded", "obsolete", "updated", "consolidated"]
        },
        "reason": { "type": "string", "minLength": 1 },
        "archivedAt": { "type": "string", "format": "date-time" },
        "replacementId": { "type": ["string", "null"], "pattern": "^mem-" },
        "snapshot": { "$ref": "#/$defs/baseMemory" }
      },
      "additionalProperties": false
    }
  }
}
