{
  "schemaVersion": 1,
  "policy": "failure-learning-v1",
  "failureClasses": [
    "tool-error",
    "validation-error",
    "timeout",
    "permission",
    "dependency",
    "logic",
    "environment",
    "unknown"
  ],
  "minimumPatternOccurrences": 3,
  "minimumSuccessfulFixTests": 2,
  "maximumObservationsPerPattern": 50,
  "maximumFixTestsPerPattern": 20,
  "requireDistinctEvidence": true,
  "diagnosticSignature": {
    "version": "failure-signature-v2",
    "components": [
      "tool",
      "failure-class",
      "exit-code",
      "command-family",
      "environment-fingerprint",
      "safe-error-family"
    ],
    "storeRawCommand": false,
    "storeRawPath": false,
    "storeRawToolInput": false
  },
  "automaticCandidateValidation": {
    "enabled": true,
    "executor": "background-subagent",
    "requiresOwnerPrompt": false,
    "leaseMinutes": 60,
    "maximumConcurrentJobs": 1,
    "excludedActions": ["executar Agent", "executar TaskStop"],
    "ownerAuthorizationRequiredFor": [
      "ação destrutiva",
      "escrita remota",
      "chamada paga",
      "nova permissão",
      "escalada de privilégio"
    ]
  },
  "automaticGlobalRule": false,
  "automaticPromotion": false,
  "storeRawError": false,
  "storeRawTestOutcome": false
}
