{
  "schemaVersion": 3,
  "policy": "failure-learning-v3",
  "failureClasses": [
    "tool-error",
    "validation-error",
    "timeout",
    "permission",
    "dependency",
    "logic",
    "environment",
    "unknown"
  ],
  "minimumPatternOccurrences": 3,
  "minimumSuccessfulFixTests": 2,
  "maximumObservationsPerPattern": 50,
  "maximumFixTestsPerPattern": 20,
  "requireDistinctEvidence": true,
  "verifiedFixTests": {
    "source": "audit-self-correction",
    "requiredActionEffect": "verification",
    "requiredActionState": "succeeded",
    "requireEvidence": true,
    "requireAfterAnalysis": true,
    "requireDistinctActions": true,
    "requireDistinctExecutions": true,
    "requireConsistentStrategy": true,
    "requireConsistentCriterion": true,
    "requireAutomationJob": true,
    "requirePatternBinding": true,
    "requireHypothesisBinding": true,
    "requireDispatchBeforeVerification": true,
    "requireExplicitCommandBinding": true,
    "requireActionFamilyBinding": true,
    "storeRawOutcome": false
  },
  "diagnosticSignature": {
    "version": "failure-signature-v2",
    "components": [
      "tool",
      "failure-class",
      "exit-code",
      "command-family",
      "environment-fingerprint",
      "safe-error-family"
    ],
    "storeRawCommand": false,
    "storeRawPath": false,
    "storeRawToolInput": false
  },
  "automaticCandidateValidation": {
    "enabled": true,
    "executorCapability": "failure-validation",
    "transport": "adapter-owned",
    "requiresOwnerPrompt": false,
    "dispatchGuarantee": "required-until-started-event",
    "realStartEventRequired": true,
    "startEvidence": "neutral-delegation-started",
    "stopGateRequiresStart": true,
    "retryableFailureDisposition": "requeue-different-strategy",
    "terminalBlockedState": false,
    "ownerDecisionOnlyForConcreteAuthorityExpansion": true,
    "dispatchTimeoutMinutes": 15,
    "leaseMinutes": 60,
    "maximumConcurrentJobs": 1,
    "excludedActions": [
      "executar delegation-control",
      "aplicar personalidade canonica na conversa"
    ],
    "ownerAuthorizationRequiredFor": [
      "ação destrutiva",
      "escrita remota",
      "chamada paga",
      "nova permissão",
      "escalada de privilégio"
    ],
    "ownerAuthorityEffects": [
      "destructive",
      "remote-write",
      "paid-call",
      "new-permission",
      "privilege-escalation"
    ]
  },
  "automaticGlobalRule": false,
  "automaticPromotion": false,
  "storeRawError": false,
  "storeRawTestOutcome": false
}
