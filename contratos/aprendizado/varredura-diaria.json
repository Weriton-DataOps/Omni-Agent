{
  "schemaVersion": 1,
  "contract": "omni-daily-activity-scan-v1",
  "automaticIntervalMinutes": 60,
  "settleMinutes": 5,
  "maximumFilesPerScan": 500,
  "maximumBytesPerScan": 524288000,
  "maximumProcessedEvidence": 50000,
  "maximumScanHistory": 60,
  "sources": ["claude-code-jsonl"],
  "targets": ["memory", "failures", "shortcuts", "operational-improvements"],
  "requestedWorkflow": {
    "actions": ["scan", "deduplicate", "evaluate", "materialize-portable", "run-gates", "commit", "push", "report"],
    "publishOnlyPortableArtifacts": true,
    "requireGreenGatesBeforeCommit": true,
    "requireOriginMainConfirmation": true
  },
  "report": {
    "requiredSections": [
      "before-and-after",
      "findings",
      "discarded-with-reasons",
      "validated",
      "eligible-for-publication",
      "actually-published",
      "gates",
      "local-or-observing"
    ],
    "publicationEvidence": ["changed-files", "commit", "origin-main-confirmation"]
  },
  "privacy": {
    "storeRawConversation": false,
    "storeRawToolResults": false,
    "storeRawErrors": false,
    "storeSecrets": false
  }
}
