{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Weriton-DataOps/Omni-Agent/contratos/aprendizado/autoaperfeicoamento.schema.json",
  "title": "Omni Self Improvement Store V1",
  "type": "object",
  "required": ["schemaVersion", "store", "proposals"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "store": {
      "type": "object",
      "required": ["id", "createdAt", "updatedAt"],
      "properties": {
        "id": { "const": "omni-local-self-improvement" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id", "category", "destination", "status", "source", "draft", "evaluation",
          "approval", "promotion", "createdAt", "updatedAt"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^improvement-" },
          "category": {
            "enum": ["learning", "shortcut", "bug-fix", "new-knowledge", "new-procedure", "new-capability", "failure-pattern", "agent-improvement"]
          },
          "destination": {
            "enum": [
              "discard", "memory", "operational-rule", "procedure", "routing", "hook",
              "runtime-fix", "personality", "eval", "capability"
            ]
          },
          "status": { "enum": ["draft", "evaluated", "approved", "rejected", "materialized-pending-version", "retracted"] },
          "source": { "type": "object" },
          "draft": { "type": "object" },
          "evaluation": { "type": ["object", "null"] },
          "approval": { "type": ["object", "null"] },
          "promotion": { "type": ["object", "null"] },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        },
        "allOf": [
          {
            "if": {
              "properties": { "status": { "const": "retracted" } },
              "required": ["status"]
            },
            "then": {
              "properties": {
                "promotion": {
                  "type": "object",
                  "required": ["status", "retraction"],
                  "properties": {
                    "status": { "const": "retracted" },
                    "retraction": {
                      "type": "object",
                      "required": [
                        "status", "reason", "retractedAt", "replacedBy", "evidence", "observedInstalledRelease"
                      ],
                      "properties": {
                        "status": { "const": "retracted-replaced-by-runtime-fix" },
                        "reason": { "type": "string", "minLength": 10 },
                        "retractedAt": { "type": "string", "format": "date-time" },
                        "replacedBy": {
                          "type": "object",
                          "required": ["runtime", "tests"],
                          "properties": {
                            "runtime": { "type": "string", "pattern": "^runtime/" },
                            "tests": {
                              "type": "array",
                              "minItems": 1,
                              "items": { "type": "string", "pattern": "^testes/" }
                            }
                          },
                          "additionalProperties": false
                        },
                        "evidence": {
                          "type": "object",
                          "required": [
                            "auditPath", "auditSha256", "preserved", "source", "evaluation", "retractedArtifact"
                          ],
                          "properties": {
                            "auditPath": {
                              "type": "string",
                              "pattern": "^contratos/aprendizado/promocoes/[a-z0-9][a-z0-9-]{1,80}\\.json$"
                            },
                            "auditSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                            "preserved": { "const": true },
                            "source": { "type": "object" },
                            "evaluation": { "type": "object" },
                            "retractedArtifact": {
                              "type": "object",
                              "required": ["skill", "skillSha256", "catalogEntry"],
                              "properties": {
                                "skill": { "type": "string" },
                                "skillSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                                "catalogEntry": { "type": "string" }
                              },
                              "additionalProperties": false
                            }
                          },
                          "additionalProperties": false
                        },
                        "observedInstalledRelease": {
                          "type": "object",
                          "required": ["version", "payloadFingerprint", "verifiedAt"],
                          "properties": {
                            "version": { "type": "string", "minLength": 1 },
                            "payloadFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                            "verifiedAt": { "type": "string", "format": "date-time" }
                          },
                          "additionalProperties": false
                        }
                      },
                      "additionalProperties": false
                    }
                  }
                }
              }
            }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
