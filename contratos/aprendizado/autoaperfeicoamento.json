{
  "schemaVersion": 1,
  "pipeline": "self-improvement-v1",
  "categories": [
    "learning",
    "shortcut",
    "bug-fix",
    "new-knowledge",
    "new-procedure",
    "new-capability",
    "failure-pattern",
    "agent-improvement"
  ],
  "destinations": [
    "discard",
    "memory",
    "operational-rule",
    "procedure",
    "routing",
    "hook",
    "runtime-fix",
    "personality",
    "eval",
    "capability"
  ],
  "implementationRoutes": {
    "operational-rule": "contract-change",
    "procedure": "procedure-change",
    "routing": "runtime-change",
    "hook": "runtime-change",
    "runtime-fix": "runtime-change",
    "personality": "personality-candidate-and-real-eval",
    "eval": "eval-change",
    "capability": "skill-admission"
  },
  "minimumSuccessfulRuns": 4,
  "requiresIndependentValidation": true,
  "requiresOwnerApproval": true,
  "requiresPortableConfirmation": true,
  "requiresRoleFitConfirmation": true,
  "skillAdmissionQuestions": [
    "A capacidade é necessária diretamente para o papel de assistente cognitivo pessoal e continuidade do trabalho?",
    "A necessidade apareceu em um fluxo real do Omni?",
    "A capacidade pertence ao Omni, em vez de apenas poder ser delegada a um especialista futuro?",
    "A capacidade evita transformar o Omni em programador, revisor, QA, designer, especialista de infraestrutura ou orquestrador universal?",
    "Existe evidência repetível de utilidade e resultado?"
  ],
  "automaticPromotion": false,
  "automaticGitCommit": false,
  "automaticGitPush": false,
  "storeRawOutcome": false
}
