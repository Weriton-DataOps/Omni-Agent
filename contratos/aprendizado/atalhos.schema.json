{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Weriton-DataOps/Omni-Agent/contratos/aprendizado/atalhos.schema.json",
  "title": "Omni Shortcut Learning Store V2",
  "type": "object",
  "required": ["schemaVersion", "store", "shortcuts", "archive"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "store": {
      "type": "object",
      "required": ["id", "createdAt", "updatedAt"],
      "properties": {
        "id": { "const": "omni-local-shortcut-learning" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "shortcuts": { "type": "array", "items": { "$ref": "#/$defs/shortcut" } },
    "archive": { "type": "array", "items": { "$ref": "#/$defs/archive" } }
  },
  "additionalProperties": false,
  "$defs": {
    "scope": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["user", "project", "task", "environment"] },
        "id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "required": ["id", "recordedAt", "success", "consistent", "outcomeFingerprint", "durationMs"],
      "properties": {
        "id": { "type": "string", "pattern": "^obs-" },
        "recordedAt": { "type": "string", "format": "date-time" },
        "success": { "type": "boolean" },
        "consistent": { "type": "boolean" },
        "outcomeFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "durationMs": { "type": ["integer", "null"], "minimum": 0 }
      },
      "additionalProperties": false
    },
    "validation": {
      "type": ["object", "null"],
      "required": ["status", "validatedAt", "observationId"],
      "properties": {
        "status": { "enum": ["passed", "failed"] },
        "validatedAt": { "type": "string", "format": "date-time" },
        "observationId": { "type": "string", "pattern": "^obs-" }
      },
      "additionalProperties": false
    },
    "shortcut": {
      "type": "object",
      "required": [
        "id", "family", "goal", "scope", "baselineSteps", "shortcutSteps", "status",
        "outcomeFingerprint", "consecutiveSuccesses", "successCount", "failureCount",
        "inconsistentCount", "usageCount", "lastSucceededAt", "lastUsedAt", "mergedFrom",
        "observations", "validation", "createdAt", "updatedAt"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^shortcut-" },
        "family": { "type": "string", "minLength": 1 },
        "goal": { "type": "string", "minLength": 1 },
        "scope": { "$ref": "#/$defs/scope" },
        "baselineSteps": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
        "shortcutSteps": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "status": { "enum": ["observing", "active", "validated"] },
        "outcomeFingerprint": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "consecutiveSuccesses": { "type": "integer", "minimum": 0 },
        "successCount": { "type": "integer", "minimum": 0 },
        "failureCount": { "type": "integer", "minimum": 0 },
        "inconsistentCount": { "type": "integer", "minimum": 0 },
        "usageCount": { "type": "integer", "minimum": 0 },
        "lastSucceededAt": { "type": ["string", "null"], "format": "date-time" },
        "lastUsedAt": { "type": ["string", "null"], "format": "date-time" },
        "mergedFrom": { "type": "array", "items": { "type": "string", "pattern": "^shortcut-" } },
        "observations": { "type": "array", "items": { "$ref": "#/$defs/observation" } },
        "validation": { "$ref": "#/$defs/validation" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "archive": {
      "type": "object",
      "required": ["id", "shortcutId", "family", "scope", "reason", "mergedInto", "successCount", "failureCount", "archivedAt"],
      "properties": {
        "id": { "type": "string", "pattern": "^shortcut-archive-" },
        "shortcutId": { "type": "string", "pattern": "^shortcut-" },
        "family": { "type": "string", "minLength": 1 },
        "scope": { "$ref": "#/$defs/scope" },
        "reason": { "enum": ["identity-merged", "inactive", "repeated-failure"] },
        "mergedInto": { "type": ["string", "null"], "pattern": "^shortcut-" },
        "successCount": { "type": "integer", "minimum": 0 },
        "failureCount": { "type": "integer", "minimum": 0 },
        "archivedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    }
  }
}
