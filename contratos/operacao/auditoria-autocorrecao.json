{
  "schemaVersion": 1,
  "contract": "omni-audit-self-correction-v1",
  "enabled": true,
  "retention": {
    "turns": 300,
    "actionsPerTurn": 120,
    "evidencePerTurn": 120,
    "findingsPerTurn": 40,
    "correctionsPerTurn": 40
  },
  "stopGate": {
    "enabled": true,
    "maximumBlocksPerTurn": 1,
    "requireVerificationAfterMutation": true,
    "requireVerificationAfterDelegation": true,
    "rejectUnverifiedCompletionClaims": true,
    "recursionGuardRequired": true
  },
  "correction": {
    "producesRepairDirectiveOnly": false,
    "producesRecoverableWork": true,
    "reversibleAuthorizedRepair": "execute-or-delegate-automatically",
    "neverExecutesExternalMutation": true,
    "idempotentByFindingFingerprint": true,
    "maximumIdenticalFailedStrategies": 1,
    "requireDifferentStrategyAfterFailure": true,
    "requireReadBackAfterCorrection": true
  },
  "authority": {
    "doesNotGrantNewAuthority": true,
    "allRepairsRemainBoundByCurrentRequest": true,
    "automaticWithoutNewApproval": [
      "reversible-omni-source-correction",
      "tests-and-evals",
      "authorized-release-cycle"
    ],
    "ownerDecisionOnlyWhen": [
      "material-objective-expansion",
      "new-secret-identity-privilege-or-financial-effect",
      "irreversible-effect-without-credible-recovery"
    ]
  },
  "recovery": {
    "terminalizeOnRecursionGuard": false,
    "terminalizeOnSessionEnd": false,
    "legacyBlockedTurnsBecomeRepairing": true,
    "resumeAutomaticallyWhenCauseClears": true,
    "survivesSessionAndReleaseBoundary": true
  },
  "objectiveBinding": {
    "algorithm": "omni-authority-objective-v1",
    "legacyWithoutAlgorithm": "unverifiable",
    "storeRawObjective": false
  },
  "privacy": {
    "storeRawRequest": false,
    "storeRawResponse": false,
    "storeRawToolInput": false,
    "storeRawToolOutput": false,
    "storeRawError": false,
    "storeSecrets": false
  }
}
