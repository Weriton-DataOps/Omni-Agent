{
  "schemaVersion": 1,
  "contract": "omni-system-self-audit-v1",
  "triggers": ["daily-scan", "before-release", "owner-request"],
  "history": {
    "maximumRuns": 120,
    "idempotentByStateFingerprint": true,
    "reuseLatestUnchangedRun": true
  },
  "repairPolicy": {
    "automatic": [
      "coalesce-duplicate-failure-jobs",
      "supersede-stale-jobs",
      "migrate-local-stores-with-backup",
      "reconcile-inactive-turn-findings",
      "reconcile-orphan-delegations",
      "materialize-ready-operational-improvements",
      "serialize-operational-improvements-per-repository",
      "route-source-improvements-to-neutral-delegation"
    ],
    "requiresIndependentReadback": true,
    "sourceChangesUseImplementationRoute": true,
    "doesNotExpandCurrentAuthority": true
  },
  "findings": [
    "release-integrity-drift",
    "real-behavior-eval-missing",
    "trusted-personality-eval-missing",
    "personality-self-claims-unverified",
    "learned-personality-cases-pending",
    "duplicate-active-failure-jobs",
    "unverified-delegations",
    "delegations-awaiting-proof",
    "self-repair-stages-degraded",
    "unresolved-turn-findings",
    "duplicate-portable-rules",
    "evaluated-learning-without-route",
    "materialized-learning-without-installed-readback",
    "operational-improvement-ready-without-materialization",
    "operational-implementation-required",
    "operational-materialized-without-installed-readback",
    "operational-installed-without-loaded-readback"
  ],
  "turnFindingLifecycle": {
    "recoverable": {
      "findingStates": ["open", "unresolved"],
      "severity": "error",
      "releaseBlocking": false,
      "survivesSessionAndReleaseBoundary": true,
      "retestAutomatically": true,
      "terminalArchiveWithoutCounterproof": false
    }
  },
  "classification": {
    "categories": [
      "actionable-debt",
      "awaiting-proof",
      "terminal-without-success",
      "historical-unverifiable",
      "superseded",
      "verified",
      "observing"
    ],
    "historicalTotalsRemainObservable": true,
    "actionableFindingsExcludeTerminal": true,
    "delegations": {
      "actionableStates": ["prepared", "visible", "running", "blocked"],
      "awaitingProofStates": ["reported"],
      "terminalWithoutSuccessStates": ["failed", "cancelled"],
      "terminalStatesOverrideLegacyFlag": true,
      "verifiedStates": ["verified", "closed"],
      "historicalUnverifiableStates": ["archived"],
      "historicalUnverifiableOutcomes": ["legacy-unverified", "historical-unverifiable"]
    },
    "turnFindings": {
      "actionableStates": ["open", "unresolved"],
      "terminalWithoutSuccessStates": ["owner-reconfirmation-required"],
      "historicalUnverifiableStates": ["historical-unverifiable"],
      "supersededStates": ["superseded"],
      "verifiedStates": ["corrected"],
      "terminalContainerStates": ["verified", "closed", "failed", "cancelled", "archived"]
    },
    "operationalImprovements": {
      "actionableStates": ["ready", "implementation-required", "materialized-pending-release"],
      "awaitingProofStates": ["installed-verified"],
      "verifiedStates": ["loaded-verified"],
      "supersededStates": ["superseded"],
      "observingStates": ["observing"]
    }
  },
  "metrics": [
    "findingCorrectionRate",
    "findingRecurrenceRate",
    "evidenceCoverage",
    "sameTurnCorrectionRate",
    "verifiedDelegationRate",
    "delegationHistoricalTotal",
    "delegationActionableDebt",
    "delegationAwaitingProof",
    "delegationTerminalWithoutSuccess",
    "delegationHistoricalUnverifiable",
    "delegationVerified",
    "turnFindingHistoricalTotal",
    "turnFindingActionableDebt",
    "turnFindingTerminalWithoutSuccess",
    "turnFindingHistoricalUnverifiable",
    "turnFindingSuperseded",
    "turnFindingVerified",
    "selfRepairRunsObserved",
    "selfRepairConsecutiveDegradedRuns",
    "selfRepairFailedStagesLatest",
    "personalityRealPassRate",
    "personalityTrustedPassRate",
    "personalityUnverifiedClaims",
    "learningEffectRate",
    "selfImprovementRetracted",
    "activeQueueDuplicateRate",
    "operationalImprovementReady",
    "operationalImplementationRequired",
    "operationalMaterializedPendingRelease",
    "operationalInstalledVerified",
    "operationalLoadedVerified",
    "operationalSuperseded",
    "operationalImprovementHistoricalTotal",
    "operationalImprovementActionableDebt",
    "operationalImprovementAwaitingProof",
    "operationalImprovementHistoricalUnverifiable",
    "operationalImprovementObserving",
    "operationalLearningEffectRate"
  ],
  "privacy": {
    "storeRawConversation": false,
    "storeRawToolData": false,
    "storeRawPaths": false,
    "storeSecrets": false,
    "pluginVersionAllowlist": "semver"
  }
}
