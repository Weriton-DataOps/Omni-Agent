{
  "schemaVersion": 1,
  "contract": "omni-operational-cycle-v1",
  "authorityContract": "omni-responsible-freedom-v1",
  "eventRetention": 500,
  "sessionRetention": 100,
  "delegationRetention": 200,
  "improvementRetention": 100,
  "learning": {
    "observeUserCorrections": true,
    "observeToolFailures": true,
    "observeVerifiedCompletions": true,
    "captureSeveralSignalsPerTurn": true,
    "promoteExplicitStablePreferences": true
  },
  "improvement": {
    "states": [
      "observing",
      "ready",
      "implementation-required",
      "materialized-pending-release",
      "installed-verified",
      "loaded-verified",
      "superseded"
    ],
    "transitions": {
      "observing": ["ready"],
      "ready": ["implementation-required", "materialized-pending-release"],
      "implementation-required": ["materialized-pending-release"],
      "materialized-pending-release": ["installed-verified", "superseded"],
      "installed-verified": ["loaded-verified", "superseded"],
      "loaded-verified": [],
      "superseded": []
    },
    "minimumOccurrencesReady": 2,
    "materializedState": "materialized-pending-release",
    "installedState": "installed-verified",
    "effectiveState": "loaded-verified",
    "supersededState": "superseded",
    "reinforcementNeverRegressesState": true,
    "installedVerificationRequiresReleaseIntegrity": true,
    "loadedVerificationRequiresRuntimeIdentity": true,
    "supersededRequiresExplicitLoadedReplacement": true,
    "sourceImplementationRequiresAuditedMutationAndReadback": true
  },
  "delegation": {
    "states": [
      "prepared",
      "visible",
      "running",
      "reported",
      "verified",
      "closed",
      "blocked",
      "failed",
      "cancelled",
      "archived"
    ],
    "transitions": {
      "prepared": ["visible", "failed", "cancelled"],
      "visible": ["running", "failed", "cancelled"],
      "running": ["reported", "blocked", "failed", "cancelled"],
      "reported": ["verified", "running", "blocked", "failed", "cancelled", "archived"],
      "verified": ["closed"],
      "blocked": ["running", "failed", "cancelled"],
      "closed": [],
      "failed": [],
      "cancelled": [],
      "archived": []
    },
    "successStates": ["verified"],
    "terminalStates": ["closed", "failed", "cancelled", "archived"],
    "historicalUnverifiableState": "archived",
    "historicalUnverifiableOutcome": "historical-unverifiable",
    "orphanVisibleLeaseMinutes": 60,
    "closedSuccessRequiresOutcome": "verified",
    "executorReportProduces": "reported",
    "inboundCannotProduce": ["verified", "closed", "archived"],
    "externalCorrelation": "delegation-id",
    "untrackedExecutorProduces": "failed",
    "adapterCorrelation": {
      "requiresExplicitDelegationId": true,
      "uncorrelatedEvent": "rejected-no-state",
      "bindExecutorOnStarted": true,
      "duplicateRequiresSameExecutor": true
    },
    "evidenceRequiredFor": ["visible", "running", "reported", "verified", "blocked", "failed", "cancelled", "archived"],
    "targetReceivesVisiblePrompt": true,
    "centralConversationRemainsAvailable": true,
    "completionReturnsEvidence": true,
    "authorityIsInherited": true,
    "reportedIsNotSuccess": true,
    "verificationPrecedesClosure": true,
    "verifiedRequiresAuditActionAndEvidence": true,
    "verificationMustFollowReport": true,
    "verificationMustMatchAuditedObject": true
  },
  "privacy": {
    "storeRawConversation": false,
    "storeRawToolOutput": false,
    "storeRawError": false,
    "storeSecrets": false
  }
}
