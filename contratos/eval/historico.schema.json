{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Weriton-DataOps/Omni-Agent/contratos/eval/historico.schema.json",
  "title": "Omni Eval History V1",
  "type": "object",
  "required": ["schemaVersion", "store", "runs"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "store": {
      "type": "object",
      "required": ["id", "createdAt", "updatedAt"],
      "properties": {
        "id": { "const": "omni-local-eval-history" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "runs": {
      "type": "array",
      "items": { "$ref": "#/$defs/run" }
    }
  },
  "$defs": {
    "result": {
      "type": "object",
      "required": ["caseId", "passed", "score", "latencyMs", "costUsd", "evidenceFingerprint"],
      "properties": {
        "caseId": { "type": "string", "minLength": 1 },
        "passed": { "type": "boolean" },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "latencyMs": { "type": "number", "minimum": 0 },
        "costUsd": { "type": "number", "minimum": 0 },
        "evidenceFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "required": ["sampleCount", "successRate", "averageScore", "averageLatencyMs", "totalCostUsd"],
      "properties": {
        "sampleCount": { "type": "integer", "minimum": 1 },
        "successRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "averageScore": { "type": "number", "minimum": 0, "maximum": 1 },
        "averageLatencyMs": { "type": "number", "minimum": 0 },
        "totalCostUsd": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "required": ["id", "target", "suite", "changeId", "label", "executedAt", "results", "metrics"],
      "properties": {
        "id": { "type": "string", "pattern": "^eval-run-" },
        "target": { "const": "omni" },
        "suite": { "const": "omni-core-v1" },
        "changeId": { "type": "string", "minLength": 2, "maxLength": 200 },
        "label": { "type": "string", "minLength": 2, "maxLength": 200 },
        "executedAt": { "type": "string", "format": "date-time" },
        "results": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/result" } },
        "metrics": { "$ref": "#/$defs/metrics" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
