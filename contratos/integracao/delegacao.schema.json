{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Weriton-DataOps/Omni-Agent/contratos/integracao/delegacao.schema.json",
  "title": "Omni Neutral Delegation Port V1",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/event" }
  ],
  "$defs": {
    "brief": {
      "type": "object",
      "required": ["objective", "scope", "constraints", "successCriteria"],
      "properties": {
        "objective": { "type": "string", "minLength": 3, "maxLength": 500 },
        "scope": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "minLength": 1, "maxLength": 240 }
        },
        "constraints": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "minLength": 1, "maxLength": 240 }
        },
        "successCriteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "type": "string", "minLength": 1, "maxLength": 240 }
        }
      },
      "additionalProperties": false
    },
    "risk": {
      "type": "object",
      "required": ["reversibility", "reach", "data", "mode"],
      "properties": {
        "reversibility": {
          "enum": ["unclassified", "reversible", "compensable", "irreversible"]
        },
        "reach": {
          "enum": [
            "unclassified",
            "local-isolated",
            "single-scoped-target",
            "multi-target",
            "production-or-external"
          ]
        },
        "data": { "enum": ["unclassified", "public", "project", "personal", "secret"] },
        "mode": { "enum": ["proceed", "prepare-and-proceed", "owner-decision"] }
      },
      "additionalProperties": false
    },
    "authority": {
      "type": "object",
      "required": ["ref", "effectClasses", "risk"],
      "properties": {
        "ref": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "effectClasses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "read",
              "execute",
              "write",
              "network",
              "remote-write",
              "destructive",
              "financial",
              "privilege"
            ]
          }
        },
        "risk": { "$ref": "#/$defs/risk" }
      },
      "additionalProperties": false
    },
    "evidenceRef": {
      "type": "object",
      "required": ["kind", "ref"],
      "properties": {
        "kind": {
          "enum": [
            "delivery",
            "execution",
            "report",
            "diagnostic",
            "checkpoint",
            "rollback",
            "compensation",
            "other"
          ]
        },
        "ref": { "type": "string", "minLength": 1, "maxLength": 240 },
        "sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "required": [
        "schemaVersion",
        "contract",
        "messageType",
        "delegationId",
        "idempotencyKey",
        "issuedAt",
        "conversationRef",
        "destinationCapability",
        "brief",
        "authority",
        "briefRetention"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "contract": { "const": "omni-neutral-delegation-v1" },
        "messageType": { "const": "request" },
        "delegationId": { "type": "string", "pattern": "^delegation-" },
        "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 240 },
        "issuedAt": { "type": "string", "format": "date-time" },
        "conversationRef": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "destinationCapability": { "type": "string", "minLength": 1, "maxLength": 240 },
        "brief": { "$ref": "#/$defs/brief" },
        "authority": { "$ref": "#/$defs/authority" },
        "briefRetention": { "const": "ephemeral-not-stored-by-omni" }
      },
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": [
        "schemaVersion",
        "contract",
        "messageType",
        "eventId",
        "delegationId",
        "kind",
        "occurredAt",
        "executorRef",
        "summary",
        "evidenceRefs"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "contract": { "const": "omni-neutral-delegation-v1" },
        "messageType": { "const": "event" },
        "eventId": { "type": "string", "minLength": 1, "maxLength": 240 },
        "delegationId": { "type": "string", "pattern": "^delegation-" },
        "kind": { "enum": ["delivered", "started", "reported", "blocked", "failed", "cancelled"] },
        "occurredAt": { "type": "string", "format": "date-time" },
        "executorRef": { "type": ["string", "null"], "maxLength": 240 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/evidenceRef" }
        }
      },
      "additionalProperties": false
    }
  }
}
